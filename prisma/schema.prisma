generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PromoCampaign {
  id               String   @id @default(cuid())
  judulKampanye    String
  brandMekanisme   String
  waktuMulai       DateTime
  waktuBerakhir    DateTime
  urlSkuMaterial   String
  status           String   @default("SCHEDULED") // SCHEDULED, ACTIVE, COMPLETED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Idempotensi notifikasi: cegah pengiriman dobel saat cron berjalan berkali-kali
  notifStartSent       Boolean @default(false)
  notifStartReminderSent Boolean @default(false)
  notifEndReminderSent Boolean @default(false)
  notifEndSent         Boolean @default(false)
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  keys      String   // JSON string {"p256dh": "...", "auth": "..."}
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
